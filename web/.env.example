# =============================================================
# Stripe — event registration & payment
# =============================================================
# Create both keys at https://dashboard.stripe.com/apikeys
# Paste actual values in .env.local (gitignored). NEVER commit
# real keys.
STRIPE_SECRET_KEY=<paste-your-stripe-secret-key-here>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<paste-your-stripe-publishable-key-here>

# Canonical site origin used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=https://outpouringmissions.org

# =============================================================
# Sanity — CMS for posts, events, ministries
# =============================================================
# Sign up at sanity.io, create a project, paste its ID here.
# Studio is embedded at /studio — write-access controlled there.
NEXT_PUBLIC_SANITY_PROJECT_ID=<your-sanity-project-id>
NEXT_PUBLIC_SANITY_DATASET=production

# =============================================================
# Contact form — email delivery (Resend)
# =============================================================
# Optional. When set, the contact form delivers to this inbox.
# Without it, submissions are logged to the server console.
RESEND_API_KEY=<paste-your-resend-api-key-here>
CONTACT_INBOX_EMAIL=hello@outpouringmissions.org
